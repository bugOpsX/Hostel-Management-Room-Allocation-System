# ========================================================
# HMRAS - Hostel Management System Environment Configuration
# ========================================================

# Application Port
PORT=3000

# Environment: 'production' or 'development'
NODE_ENV=production

# Strong Session Secret (Generate using: openssl rand -hex 32)
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string_here

# Database Storage Location (Defaults to ./hostel.db in project root)
DB_PATH=./hostel.db

# Backup Archive Directory
BACKUP_DIR=./backups

# HTTPS Cookie Enforcement (Set to false only if running local HTTP without SSL)
COOKIE_SECURE=true
